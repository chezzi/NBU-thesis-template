\RequirePackage{booktabs}
\makeatletter
\let\tableorig\table
\def\table@i[#1]{\tableorig[#1]\renewcommand{\arraystretch}{1.5}\zihao{5}}   
\def\table@ii{\tableorig\renewcommand{\arraystretch}{1.5}\zihao{5}} 
\def\table{\@ifnextchar[\table@i \table@ii} 
\makeatother



