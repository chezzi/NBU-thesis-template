    \addcontentsline{toc}{chapter}{引\hspace{2em}言}
}


% -------------------------  摘要调节  ------------------------- %
\RequirePackage{mfirstuc} % 首字母大写
\newcommand{\tableformatset}{\ctexset{chapter/beforeskip=-0.9\baselineskip}}
\newcommand{\tableformatreset}{\ctexset{chapter/beforeskip=0.45\baselineskip}}
\newcounter{countargs}  
\newcounter{iterateargs} 
\newcommand{\keywords}[2]{%
\begingroup
    \kwlabel\nobreak\hspace{0.25em}%
    \setcounter{countargs}{0}%
    \renewcommand*{\do}[1]{\stepcounter{countargs}}%
    \docsvlist{#1}%
    \setcounter{iterateargs}{0}%
    \renewcommand*{\do}[1]{%
        \stepcounter{iterateargs}%
        \printkeyword{##1}%
        \ifnum\value{iterateargs}<\value{countargs}%
            \keywordlistsep{#2}%
        \fi
    }%
    \docsvlist{#1}%
\endgroup
}
\newcommand{\kwlabel}{{\kwlabelfmt 关键词}}
% 关键字标签格式
\newcommand{\kwlabelfmt}{\sffamily}
% 关键字格式
\newcommand{\printkeyword}[1]{\heiti\capitalisewords{#1}}
% 关键字分隔符
\newcommand{\keywordlistsep}[1]{#1}

% 中文摘要环境

\newenvironment{abstract}
{ \clearpage 
  \begin{center} 
    {\zihao{3}\heiti \thesistitle \par} \vspace{0.7em} {\zihao{-3}\heiti 摘\hspace{2em}要 \par} 
  \end{center} \vspace{1em} \rmfamily }
  { \par }

% 英文摘要环境
\newenvironment{abstractEN}{
    \tableformatset
    \ctexset{chapter={format=\centering\bfseries\zihao{-3},beforeskip=-0.9\baselineskip}}
    \chapter*{{\zihao{-2}\bfseries \thesistitleEN}\\[0.7em]
	{\zihao{-3}\bfseries Abstract}}

    \vspace{0.5em}
    \setlength{\parindent}{1em}
    \renewcommand{\kwlabel}{{\kwlabelfmt \bfseries \zihao{-4}Key Words:}}
    \renewcommand{\keywordlistsep}[1]{##1\space}
    \rmfamily
}{
  \par
  \tableformatreset
}

% -------------------------  图表格式  ------------------------- %
% caption标签设置
\RequirePackage{caption}
\RequirePackage[labelformat=simple]{subcaption}
\DeclareCaptionFont{captionfont}{ \fontsize{10.5bp}{14.5bp}\selectfont}
\captionsetup[figure]{
  format         = hang,
  font           = captionfont,
  labelsep       = quad,
  aboveskip      = 6pt,
  belowskip      = -8pt,
  position = bottom,
}
\captionsetup[table]{
  format         = hang,
  font           = captionfont,
  labelsep       = quad,
  aboveskip      = 4pt,
  belowskip      = 4pt,
  position  = top,
}
\renewcommand\thefigure{\thechapter.\arabic{figure}}
\renewcommand\thetable{\thechapter-\arabic{table}}
\captionsetup[sub]{font=captionfont}
\renewcommand{\thesubfigure}{(\alph{subfigure})}
\renewcommand{\thesubtable}{(\alph{subtable})}
% 浮动体间距设置
\setlength{\floatsep}{7.5pt}
% \setlength{\textfloatsep}{-4bp}
\setlength{\intextsep}{7.5pt}
\makeatletter
\renewcommand\normalsize{
  \@setfontsize\normalsize{12bp}{14.4bp}
  \abovedisplayskip 3\p@ \@plus1\p@ \@minus1\p@
  \abovedisplayshortskip 2\p@
  \belowdisplayshortskip 2\p@
  \belowdisplayskip \abovedisplayskip}
\normalsize
\makeatother

\RequirePackage{multirow}
